---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, languages, type SupportedLocale } from '../i18n/ui';
import { useTranslations, getAlternateLinks, getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLocale;
  image?: string;
}

const url = Astro.url;
const currentLang = Astro.props.lang || getLangFromUrl(url) || defaultLang;
const t = useTranslations(currentLang);

const title = Astro.props.title || t('site.title');
const description = Astro.props.description || t('site.description');
const siteBase = (Astro.site ? Astro.site.toString() : 'https://hexhunt.github.io').replace(/\/+$/, '');
const canonicalUrl = new URL(url.pathname, siteBase).toString();
const alternateLinks = getAlternateLinks(siteBase, url.pathname);

// Premium 1200x630 Cloudinary Social Graph Graphic
const ogImage = Astro.props.image || 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

const ogLocaleMap: Record<SupportedLocale, string> = {
  en: 'en_US',
  es: 'es_ES',
  pt: 'pt_BR',
  de: 'de_DE',
  fr: 'fr_FR',
  ja: 'ja_JP',
};

const currentOgLocale = ogLocaleMap[currentLang] || 'en_US';
const alternateOgLocales = (Object.keys(ogLocaleMap) as SupportedLocale[])
  .filter((l) => l !== currentLang)
  .map((l) => ogLocaleMap[l]);

// 100% Comprehensive Schema.org Graph: WebSite + WebApplication + CollectionPage + BreadcrumbList + Organization
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteBase}/#organization`,
      name: 'HexHunt',
      url: siteBase,
      logo: {
        '@type': 'ImageObject',
        url: `${siteBase}/favicon.svg`,
        width: 64,
        height: 64,
      },
      sameAs: [
        'https://github.com/hexhunt/hexhunt.github.io',
        'https://buymeacoffee.com/kisharadilz',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteBase}/#website`,
      url: siteBase,
      name: 'HexHunt',
      description: 'Zero-maintenance automated daily color discovery platform for designers and developers.',
      publisher: {
        '@id': `${siteBase}/#organization`,
      },
      inLanguage: ['en', 'es', 'pt', 'de', 'fr', 'ja'],
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteBase}/#webapp`,
      name: 'HexHunt',
      url: siteBase,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires JavaScript. Requires HTML5.',
      description: 'A 100% serverless, zero-maintenance color discovery platform providing automated daily color palettes based on mathematical HSL color harmony algorithms.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      creator: {
        '@type': 'Person',
        name: 'Kishara Dilz',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#collection`,
      name: title,
      url: canonicalUrl,
      description: description,
      isPartOf: {
        '@id': `${siteBase}/#website`,
      },
      inLanguage: currentLang,
      breadcrumb: {
        '@id': `${canonicalUrl}#breadcrumb`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteBase}/`,
        },
        ...(currentLang !== 'en'
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: languages[currentLang].name,
                item: canonicalUrl,
              },
            ]
          : []),
      ],
    },
  ],
};
---

<!doctype html>
<html lang={currentLang} dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KZRPWCEJMV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KZRPWCEJMV');
    </script>

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Kishara Dilz" />
    <meta name="keywords" content="color palettes, color palette generator, daily colors, HSL harmonies, complementary colors, analogous colors, triadic colors, tetradic colors, hex codes, UI UX design tools, web design colors, hexhunt" />

    <!-- Advanced Indexing & Crawler Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Theme Colors for Mobile Browsers & Status Bar -->
    <meta name="theme-color" content="#30AFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- 7 Bidirectional hreflang Alternate Tags + x-default -->
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="HexHunt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HexHunt - Automated Daily Color Palettes for Designers" />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="HexHunt - Automated Daily Color Palettes for Designers" />
    <meta name="twitter:creator" content="@kisharadilz" />

    <!-- 100% Comprehensive Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Anti-FOUC Persistent Dark/Light Mode Inline Script -->
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = storedTheme || (prefersDark ? 'dark' : 'light');

          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>

  <body class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-200 antialiased selection:bg-[#30AFFF] selection:text-white">
    <!-- Header Navigation -->
    <Header currentLang={currentLang} />

    <!-- Main Content Area with Semantic Container -->
    <main class="flex-1 w-full" id="main-content">
      <slot />
    </main>

    <!-- Semantic Footer -->
    <Footer currentLang={currentLang} />
  </body>
</html>
