---
import { languages, type SupportedLocale } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  currentLang: SupportedLocale;
  className?: string;
}

const { currentLang, className = '' } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLocaleData = languages[currentLang];
---

<div class:list={["relative inline-block text-left language-picker-root", className]}>
  <button
    type="button"
    class="lang-dropdown-btn h-9 inline-flex items-center justify-center gap-1.5 px-2 sm:px-2.5 lg:px-3 text-sm font-medium rounded-lg text-slate-700 dark:text-slate-200 bg-white/90 dark:bg-slate-900 border border-[#C4F7CA] dark:border-slate-800 hover:border-[#30AFFF] dark:hover:border-[#30AFFF] hover:bg-slate-50 dark:hover:bg-slate-800 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-[#30AFFF] shrink-0"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Change Language"
    title={`Language: ${currentLocaleData.name}`}
  >
    <span class="text-base leading-none select-none">{currentLocaleData.flag}</span>
    <span class="hidden lg:inline-block text-xs font-semibold uppercase tracking-wider">{currentLang}</span>
    <svg
      class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 chevron-icon hidden lg:inline-block"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
        clip-rule="evenodd"
      />
    </svg>
  </button>

  <div
    class="lang-dropdown-menu hidden absolute right-0 mt-2 w-44 rounded-xl shadow-xl bg-white dark:bg-slate-900 border border-[#C4F7CA] dark:border-slate-800 py-1.5 z-50 ring-1 ring-black/5 focus:outline-none transition-all duration-200 backdrop-blur-lg"
    role="menu"
    aria-orientation="vertical"
  >
    {(Object.entries(languages) as [SupportedLocale, typeof currentLocaleData][]).map(([code, data]) => {
      const isCurrent = code === currentLang;
      const targetPath = getLocalizedPath(currentPath, code);

      return (
        <a
          href={targetPath}
          class:list={[
            "group flex items-center justify-between px-3.5 py-2 text-xs font-medium rounded-lg mx-1 transition-colors",
            isCurrent
              ? "bg-[#30AFFF]/10 text-[#30AFFF] font-semibold dark:bg-[#30AFFF]/20 dark:text-[#92EEFF]"
              : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white"
          ]}
          role="menuitem"
        >
          <div class="flex items-center gap-2.5">
            <span class="text-base leading-none">{data.flag}</span>
            <span>{data.name}</span>
          </div>
          {isCurrent && (
            <svg class="w-3.5 h-3.5 text-[#30AFFF] dark:text-[#92EEFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<script>
  function setupLanguagePickers() {
    const pickers = document.querySelectorAll('.language-picker-root');

    pickers.forEach((picker) => {
      const btn = picker.querySelector('.lang-dropdown-btn') as HTMLButtonElement | null;
      const menu = picker.querySelector('.lang-dropdown-menu') as HTMLDivElement | null;
      const chevron = picker.querySelector('.chevron-icon') as SVGElement | null;

      if (!btn || !menu) return;

      const toggleDropdown = (open?: boolean) => {
        const isOpen = open !== undefined ? open : menu.classList.contains('hidden');
        if (isOpen) {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          chevron?.classList.add('rotate-180');
        } else {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          chevron?.classList.remove('rotate-180');
        }
      };

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown();
      });

      document.addEventListener('click', (e) => {
        if (!picker.contains(e.target as Node)) {
          toggleDropdown(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleDropdown(false);
        }
      });
    });
  }

  setupLanguagePickers();
  document.addEventListener('astro:page-load', setupLanguagePickers);
</script>
