---
import { useTranslations } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/ui';

interface Props {
  currentLang: SupportedLocale;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
---

<section class="relative overflow-hidden pt-12 pb-6 sm:pt-16 sm:pb-8 text-center">
  <!-- Subtle Background Ambient Glows using Brand Palette (#30AFFF, #92EEFF, #D8FFC5) -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[36rem] h-[18rem] bg-gradient-to-tr from-[#30AFFF]/15 via-[#92EEFF]/20 to-[#D8FFC5]/20 blur-3xl rounded-full -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-gradient-to-r from-[#30AFFF]/10 via-[#92EEFF]/10 to-[#D8FFC5]/20 text-slate-800 dark:text-[#92EEFF] border border-[#C4F7CA] dark:border-slate-800 shadow-xs mb-5 animate-fade-in">
      <span>{t('hero.badge')}</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#30AFFF] animate-pulse"></span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-4">
      {t('hero.title')}{' '}
      <span class="bg-gradient-to-r from-[#30AFFF] via-[#0284C7] to-[#38BDF8] dark:from-[#30AFFF] dark:via-[#92EEFF] dark:to-[#D8FFC5] bg-clip-text text-transparent">
        {t('hero.titleHighlight')}
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <!-- Quick stats strip -->
    <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs font-semibold text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[#30AFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>100% Free & Open Source</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[#30AFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{t('stats.dailyUpdated')}</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[#30AFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2" />
        </svg>
        <span>One-Click Hex Copy</span>
      </div>
    </div>

  </div>
</section>
