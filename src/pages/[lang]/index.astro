---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { PaletteGrid } from '../../components/PaletteGrid';
import { useTranslations } from '../../i18n/utils';
import { languages, type SupportedLocale } from '../../i18n/ui';

export function getStaticPaths() {
  const nonDefaultLocales = (Object.keys(languages) as SupportedLocale[]).filter((l) => l !== 'en');
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<Layout
  title={t('site.title')}
  description={t('site.description')}
  lang={lang}
>
  <Hero currentLang={lang} />
  <PaletteGrid client:load currentLang={lang} />
</Layout>
